# Нормализация переносов строк: в репозитории всегда LF
* text=auto eol=lf

# Windows-скрипты требуют CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Бинарные файлы не трогать
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.doc  binary
*.docx binary
*.xls  binary
*.xlsx binary
*.zip  binary
